{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncosaferx.com/schemas/dosing_rules.schema.json",
  "type": "object",
  "required": ["rules", "dose_caps"],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" } }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed"] }
  },
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "drugs", "when", "action", "severity", "message", "source", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "drugs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "when": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "lab": { "type": "string" },
              "lt": { "type": "number" },
              "gte": { "type": "number" },
              "phenotype": { "type": "string" },
              "in": { "type": "array", "items": { "type": "string" } },
              "missing_lab": { "type": "string" },
              "missing_phenotype": { "type": "string" }
            }
          },
          "action": { "type": "string", "enum": ["delay", "hold", "reduce_dose", "avoid", "info"] },
          "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
          "message": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/source" },
          "status": { "$ref": "#/$defs/status" },
          "reviewed_by": { "type": "string" },
          "reviewed_on": { "type": "string" }
        }
      }
    },
    "dose_caps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "drug", "max_mg", "message", "source", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "drug": { "type": "string" },
          "max_mg": { "type": "number", "exclusiveMinimum": 0 },
          "message": { "type": "string" },
          "source": { "$ref": "#/$defs/source" },
          "status": { "$ref": "#/$defs/status" },
          "reviewed_by": { "type": "string" },
          "reviewed_on": { "type": "string" }
        }
      }
    }
  }
}
