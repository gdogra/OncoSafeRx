{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncosaferx.com/schemas/qt_serotonin.schema.json",
  "type": "object",
  "required": ["status", "thresholds", "qt_drugs", "serotonergic_drugs", "aliases"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["draft", "reviewed"] },
    "reviewed_by": { "type": "string" },
    "thresholds": {
      "type": "object",
      "required": ["qtc_critical_ms", "qtc_prolonged_male_ms", "qtc_prolonged_female_ms", "potassium_low_mmol_l", "magnesium_low_mg_dl", "age_risk_years"],
      "additionalProperties": { "type": "number" }
    },
    "qt_drugs": {
      "type": "object", "required": ["known", "possible", "conditional"], "additionalProperties": false,
      "properties": {
        "known": { "$ref": "#/$defs/names" }, "possible": { "$ref": "#/$defs/names" }, "conditional": { "$ref": "#/$defs/names" }
      }
    },
    "serotonergic_drugs": {
      "type": "object", "required": ["maoi", "high", "moderate"], "additionalProperties": false,
      "properties": {
        "maoi": { "$ref": "#/$defs/names" }, "high": { "$ref": "#/$defs/names" }, "moderate": { "$ref": "#/$defs/names" }
      }
    },
    "aliases": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": { "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } } }
}
